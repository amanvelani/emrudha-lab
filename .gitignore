# The published eMudhra intermediate CA pairs used by this lab are tracked.
# Keep locally generated leaf certificates and keys out of Git.
/ca/*
!/ca/intermediate/
!/ca/intermediate/**

# Generated runtime configuration and TLS material.
**/.env
**/tls/

# Short-lived Azure credentials and captured traffic.
**/secrets/
**/logs/

# .NET and Python build output.
**/bin/
**/obj/
**/__pycache__/
*.py[cod]

# macOS metadata.
.DS_Store
